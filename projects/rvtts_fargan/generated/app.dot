  </TR>
</TABLE>>];


vocoder [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD PORT="iev0"><FONT POINT-SIZE="12.0" COLOR="black">iev0</FONT></TD>
    <TD ALIGN="CENTER" ROWSPAN="2"><FONT COLOR="black" POINT-SIZE="14.0">vocoder<BR/>(FarganVocoder)</FONT></TD>
    <TD PORT="oev0"><FONT POINT-SIZE="12.0" COLOR="black">oev0</FONT></TD>
  </TR>
<TR>
<TD PORT="iev1"><FONT POINT-SIZE="12.0" COLOR="black">iev1</FONT></TD>

<TD PORT="oev1"><FONT POINT-SIZE="12.0" COLOR="black">oev1</FONT></TD>
</TR>

</TABLE>>];



uart:i -> editor:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<UartBlock>

]

editor:i -> send:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<TextLine>

]

send:o -> pcm:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<u32>

]

pcm:o ->
dup0 [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<AudioBlock>

]


dup0 -> speaker:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<AudioBlock>

]


dup0 -> wave:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<AudioBlock>

]



send:oev0 -> frontend:iev0 [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
frontend:oev1 -> send:iev0 [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
frontend:oev0 -> pre:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
pre:i -> gru:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
gru:i -> head:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
head:i -> acoustic:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
acoustic:i -> pitch:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
pitch:i -> vocoder:iev0 [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
vocoder:oev0 -> pcm:iev0 [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
vocoder:oev1 -> vocoder:iev1 [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
pcm:oev0 -> send:iev0 [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
wave:oev0 -> lcd:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]

}
