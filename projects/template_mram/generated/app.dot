





digraph structs {
    bgcolor = "white"
    node [shape=plaintext,color="black",fontcolor="black",fontname="Times-Roman"]
    rankdir=LR
    edge [arrowsize="0.5",color="black",fontcolor="black",fontname="Times-Roman"]


dc [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">dc<BR/>(RemoveDC)</FONT></TD>
  </TR>
</TABLE>>];

fft [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">fft<BR/>(FFT)</FONT></TD>
  </TR>
</TABLE>>];

gain [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">gain<BR/>(EmbeddedGain)</FONT></TD>
  </TR>
</TABLE>>];

magnitude [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">magnitude<BR/>(Magnitude)</FONT></TD>
  </TR>
</TABLE>>];

microphone [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">microphone<BR/>(MicrophoneSource)</FONT></TD>
  </TR>
</TABLE>>];

pcm [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">pcm<BR/>(PCMToFloat)</FONT></TD>
  </TR>
</TABLE>>];


send [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD PORT="i"><FONT POINT-SIZE="12.0" COLOR="black">i</FONT></TD>
    <TD ALIGN="CENTER" ROWSPAN="2"><FONT COLOR="black" POINT-SIZE="14.0">send<BR/>(SendToLCD)</FONT></TD>
    <TD PORT="oev0"><FONT POINT-SIZE="12.0" COLOR="black">oev0</FONT></TD>
  </TR>
<TR>
 
<TD></TD>
 
<TD></TD></TR>

</TABLE>>];

sliding [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">sliding<BR/>(SlidingBuffer)</FONT></TD>
  </TR>
</TABLE>>];

window [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">window<BR/>(HannWindow)</FONT></TD>
  </TR>
</TABLE>>];

lcd [label=<
<TABLE color="black" bgcolor="none" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">lcd<BR/>(LCD)</FONT></TD>
  </TR>
</TABLE>>];



microphone:i -> pcm:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<PcmBlock>

]

pcm:i -> gain:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<AudioBlock>

]

gain:i -> sliding:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<AudioBlock>

]

sliding:i -> dc:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<FFTBlock>

]

dc:i -> window:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<FFTBlock>

]

window:i -> fft:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<FFTBlock>

]

fft:i -> magnitude:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<FFTBlock>

]

magnitude:i -> send:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<SpectrumBlock>

]



send:oev0 -> lcd:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]

}
