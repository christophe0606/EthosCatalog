





digraph structs {
    bgcolor = "white"
    node [shape=plaintext,color="black",fontcolor="black",fontname="Times-Roman"]
    rankdir=LR
    edge [arrowsize="0.5",color="black",fontcolor="black",fontname="Times-Roman"]


audio_window [label=<
<TABLE color="black" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">audio_window<BR/>(SlidingBuffer)</FONT></TD>
  </TR>
</TABLE>>];


display_clock [label=<
<TABLE color="black" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD PORT="i"><FONT POINT-SIZE="12.0" COLOR="black">i</FONT></TD>
    <TD ALIGN="CENTER" ROWSPAN="2"><FONT COLOR="black" POINT-SIZE="14.0">display_clock<BR/>(KwsEvents)</FONT></TD>
    <TD PORT="oev0"><FONT POINT-SIZE="12.0" COLOR="black">oev0</FONT></TD>
  </TR>
<TR>

<TD></TD>

<TD></TD></TR>

</TABLE>>];

dup0 [shape=point,label="dup0"]


inference [label=<
<TABLE color="#7B1FA2" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD PORT="i"><FONT POINT-SIZE="12.0" COLOR="black">i</FONT></TD>
    <TD ALIGN="CENTER" ROWSPAN="2"><FONT COLOR="#7B1FA2" POINT-SIZE="14.0">inference<BR/>(KwsInference)</FONT></TD>
    <TD PORT="oev0"><FONT POINT-SIZE="12.0" COLOR="black">oev0</FONT></TD>
  </TR>
<TR>

<TD></TD>

<TD></TD></TR>

</TABLE>>];

mfcc [label=<
<TABLE color="black" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">mfcc<BR/>(MFCC)</FONT></TD>
  </TR>
</TABLE>>];

mfcc_window [label=<
<TABLE color="black" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">mfcc_window<BR/>(SlidingBuffer)</FONT></TD>
  </TR>
</TABLE>>];

microphone [label=<
<TABLE color="#8B4513" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="#8B4513" POINT-SIZE="14.0">microphone<BR/>(MicrophoneSource)</FONT></TD>
  </TR>
</TABLE>>];

pcm [label=<
<TABLE color="black" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="black" POINT-SIZE="14.0">pcm<BR/>(PCMToFloat)</FONT></TD>
  </TR>
</TABLE>>];

lcd [label=<
<TABLE color="#8B4513" bgcolor="white" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
  <TR>
    <TD ALIGN="CENTER" PORT="i"><FONT COLOR="#8B4513" POINT-SIZE="14.0">lcd<BR/>(KeywordLCD)</FONT></TD>
  </TR>
</TABLE>>];



microphone:i -> pcm:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<s16(320)>
,headlabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >320</FONT>
</TD></TR></TABLE>>
,taillabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >320</FONT>
</TD></TR></TABLE>>]

pcm:i -> audio_window:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<f32(320)>
,headlabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >320</FONT>
</TD></TR></TABLE>>
,taillabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >320</FONT>
</TD></TR></TABLE>>]

audio_window:i -> mfcc:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<f32(640)>
,headlabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >640</FONT>
</TD></TR></TABLE>>
,taillabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >640</FONT>
</TD></TR></TABLE>>]

mfcc_window:i -> inference:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<f32(490)>
,headlabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >490</FONT>
</TD></TR></TABLE>>
,taillabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >490</FONT>
</TD></TR></TABLE>>]

mfcc:i ->
dup0 [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<f32(10)>

,taillabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >10</FONT>
</TD></TR></TABLE>>]


dup0 -> mfcc_window:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<f32(250)>
,headlabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >250</FONT>
</TD></TR></TABLE>>
]


dup0 -> display_clock:i [style="solid",color="black",fontsize="12.0",fontcolor="black",label=<f32(10)>
,headlabel=<<TABLE BORDER="0" CELLPADDING="4"><TR><TD><FONT COLOR="blue" POINT-SIZE="12.0" >10</FONT>
</TD></TR></TABLE>>
]



display_clock:oev0 -> lcd:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]
inference:oev0 -> lcd:i [style="dashed",color="black",fontsize="12.0",fontcolor="black",label=<>

]

}
