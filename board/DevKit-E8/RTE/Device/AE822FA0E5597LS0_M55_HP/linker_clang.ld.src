#include "app_mem_regions.h"

#define __STACK_SIZE             APP_HP_STACK_SIZE
#ifndef __HEAP_SIZE
#define __HEAP_SIZE              APP_HP_HEAP_SIZE
#endif
#define __APP_HEAP_SIZE          0x00008000
#define __ROM_BASE               APP_MRAM_HP_BASE
#define __ROM_SIZE               APP_CODE_MRAM_SIZE

/*
 * Note:
 * The empty regions(eg SRAM1) are ON by default, but may have been released
 * by some example applications. So make sure your application requests
 * power for these regions before adding contents.
 */

MEMORY
{
  ITCM  (rwx) : ORIGIN = APP_ITCM_BASE , LENGTH = APP_HP_ITCM_SIZE
  DTCM  (rwx) : ORIGIN = APP_DTCM_BASE , LENGTH = APP_HP_DTCM_SIZE
  #if __HAS_BULK_SRAM
  SRAM0 (rwx) : ORIGIN = APP_SRAM0_BASE, LENGTH = APP_SRAM0_SIZE
  SRAM1 (rwx) : ORIGIN = APP_SRAM1_BASE, LENGTH = APP_SRAM1_SIZE
  #endif
  MRAM  (rx)  : ORIGIN = __ROM_BASE, LENGTH = __ROM_SIZE
  MRAM_USER  (rw)  : ORIGIN = APP_MRAM_USER_BASE, LENGTH = APP_MRAM_USER_SIZE
}

ENTRY(Reset_Handler)

SECTIONS
{

  .startup.at_mram : ALIGN(2048)
  {
    KEEP(*(.vectors))

    *startup*(.text* .rodata*)
    *system*(.text* .rodata*)
    *sys_*(.text* .rodata*)
    *pm*(.text* .rodata*)
    *tgu*(.text* .rodata*)
    *mpu*(.text* .rodata*)
    *sau_tcm_ns_setup*(.text* .rodata*)

    *lv_*(.text* .rodata*)

    . = ALIGN(16);
  } > MRAM

  .copy.table : ALIGN(4)
  {
    __copy_table_start__ = .;
    LONG ( LOADADDR(.data.at_dtcm) )
    LONG ( ADDR(.data.at_dtcm) )
    LONG ( SIZEOF(.data.at_dtcm)/4 )
    LONG ( LOADADDR(.code.at_itcm) )
    LONG ( ADDR(.code.at_itcm) )
    LONG ( SIZEOF(.code.at_itcm)/4 )
    LONG ( LOADADDR(.tdata) )
    LONG ( ADDR(.tdata) )
    LONG ( SIZEOF(.tdata)/4 )
    LONG ( LOADADDR(.nonsecure0_region) )
    LONG ( ADDR(.nonsecure0_region) )
    LONG ( SIZEOF(.nonsecure0_region)/4 )
    __copy_table_end__ = .;
    . = ALIGN(16);
  } > MRAM

  .zero.table : ALIGN(4)
  {
    __zero_table_start__ = .;
    LONG (ADDR(.bss))
    LONG (SIZEOF(.bss)/4)
    LONG (ADDR(.tbss))
    LONG (SIZEOF(.tbss)/4)
    /* SRAM0 pools are initialized by their owners after board power setup. */
    __zero_table_end__ = .;
    . = ALIGN(16);
  } > MRAM

  /* Read-only relocation tables remain in MRAM; writable TLS is in DTCM. */
  .got : ALIGN(8)
  {
    *(.got)
    *(.got*)
    *(.data.rel.ro)
    *(.data.rel.ro*)
    *(.got.plt)
    . = ALIGN(16);
  } > MRAM

  .code.at_itcm : ALIGN(8)
  {
    *(.itcm*)                             /* Object targeting ITCM */
    . = ALIGN(16);
  } > ITCM AT > MRAM

  .data.at_dtcm : ALIGN(8)
  {
    *(vtable)
    *(.data)
    *(.data*)
    *arm_common_tables*(.data* .rodata*)

    KEEP(*(.jcr*))

    . = ALIGN(16);
  } > DTCM AT > MRAM

  /* TLS templates and storage must be writable in DTCM. */
  .tdata : ALIGN(16)
  {
    __tls_base = .;
    __tdata_start = .;
    *(.tdata .tdata.* .gnu.linkonce.td.*)
    . = ALIGN(16);
    __tdata_end = .;
  } > DTCM AT > MRAM
  .tbss (NOLOAD) : ALIGN(16)
  {
    __tbss_start = .;
    *(.tbss .tbss.* .gnu.linkonce.tb.*)
    *(.tcommon)
    . = ALIGN(16);
    __tbss_end = .;
  } > DTCM

#if __HAS_BULK_SRAM
  .bss.at_sram0 (NOLOAD) : ALIGN(8)
  {
    *(.bss.lcd_crop_and_interpolate_buf)  /* LCD crop and intrepolate image processing buffer. */
    *(.bss.ai_pool)                       /* NPU-visible pools, no startup zero. */
    *(.bss.lcd_frame_buf)                 /* LCD frame Buffer. */
    *(.bss.camera_frame_buf)              /* Camer Frame Buffer */
    *(.bss.camera_frame_bayer_to_rgb_buf) /* (Optional) Camera Frame Buffer for Bayer to RGB Conversion. */
  } > SRAM0
#endif

  .bss (NOLOAD) : ALIGN(8)
  {
    __bss_start__ = .;
    *(.bss)
    *(.bss.*)
    *(.sbss .sbss.*)
    *(COMMON)

    . = ALIGN(8);
    __bss_end__ = .;
  } > DTCM

  /* DMA driver state is initialized through the copy table, like AC6. */
  .nonsecure0_region : ALIGN(TGU_BLOCK_SIZE)
  {
    __ns_region_0_start = .;
    * (eth_buf)
    * (usb_dma_buf)
    * (sd_dma_buf)
    * (.driver.usbd0)
    . = ALIGN(4);
  } > DTCM AT > MRAM
  __ns_region_0_end = ALIGN(ADDR(.nonsecure0_region) + SIZEOF(.nonsecure0_region), TGU_BLOCK_SIZE);

  .heap __ns_region_0_end (NOLOAD) : ALIGN(8)
  {
    __end__ = .;
    __heap_start = .;
    PROVIDE(end = .);
    . = . + __HEAP_SIZE;
    . = ALIGN(8);
    __HeapLimit = .;
    __heap_end = .;
  } > DTCM

  .__app_heap (NOLOAD) : ALIGN(8)
  {
     . = ALIGN(8);
     __RAM_segment_used_end__ = .;
     . = . + __APP_HEAP_SIZE;
     . = ALIGN(8);
   } > DTCM

  .stack (ORIGIN(DTCM) + LENGTH(DTCM) - __STACK_SIZE) (NOLOAD) : ALIGN(8)
  {
    __StackLimit = .;
    . = . + __STACK_SIZE;
    . = ALIGN(8);
    __StackTop = .;
  } > DTCM
  PROVIDE(__stack = __StackTop);

  .readonly.at_mram : ALIGN(8)
  {
    /* Match AC6: ordinary code executes in MRAM; only .itcm goes to ITCM. */
    *(.text .text.*)
    /* Use wildcards to mop up any read-only not directed to TCM */
    KEEP(*(.init))
    KEEP(*(.fini))

    . = ALIGN(4);
    /* preinit data */
    PROVIDE_HIDDEN (__preinit_array_start = .);
    PROVIDE_HIDDEN (__bothinit_array_start = .);
    KEEP(*(.preinit_array))
    PROVIDE_HIDDEN (__preinit_array_end = .);

    . = ALIGN(4);
    /* init data */
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP(*(SORT(.init_array.*)))
    KEEP(*(.init_array))
    PROVIDE_HIDDEN (__init_array_end = .);
    PROVIDE_HIDDEN (__bothinit_array_end = .);

    . = ALIGN(4);
    /* finit data */
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP(*(SORT(.fini_array.*)))
    KEEP(*(.fini_array))
    PROVIDE_HIDDEN (__fini_array_end = .);

    /* .ctors */
    *crtbegin.o(.ctors)
    *crtbegin?.o(.ctors)
    *(EXCLUDE_FILE(*crtend?.o *crtend.o) .ctors)
    *(SORT(.ctors.*))
    *(.ctors)

    /* .dtors */
    *crtbegin.o(.dtors)
    *crtbegin?.o(.dtors)
    *(EXCLUDE_FILE(*crtend?.o *crtend.o) .dtors)
    *(SORT(.dtors.*))
    *(.dtors)

    *(.rodata*)

    KEEP(*(.eh_frame*))
    . = ALIGN(16);
  } > MRAM

  .ARM.extab : ALIGN(4)
  {
    *(.ARM.extab* .gnu.linkonce.armextab.*)
  } > MRAM
  .ARM.exidx : ALIGN(4)
  {
    __exidx_start = .;
    *(.ARM.exidx* .gnu.linkonce.armexidx.*)
    __exidx_end = .;
  } > MRAM

  .mram_user (NOLOAD) : ALIGN(16)
  {
    __mram_user_start__ = .;
    *(.mram_user)
    *(.mram_user*)
    . = ALIGN(16);
    __mram_user_end__ = .;
  } > MRAM_USER

  /* Check if data + heap + stack exceeds RAM limit */
  ASSERT(__StackLimit >= __RAM_segment_used_end__ + __APP_HEAP_SIZE, "region RAM overflowed with stack")

  /* Picolib crt on clang compiler requires below definitions for data and bss sections copy.
   * We have multiple sections at diff memory locations to copy e.g. itcm, dtcm etc.
   * but the __start of picolib copies one section only.
   * So, setting data and bss defines to zero to skip it.
   */
  PROVIDE(__stack_limit = __StackLimit);
  PROVIDE(__data_start = 0);
  PROVIDE(__data_source = 0);
  PROVIDE(__data_size = 0);
  PROVIDE(__bss_start = 0);
  PROVIDE(__bss_size = 0);
  __heap_size = __heap_end - __heap_start;

  /* TLS helper sizes */
  __tdata_size = __tdata_end - __tls_base;
  __tbss_size  = __tbss_end - __tdata_end;
  __tls_end    = __tbss_end;
  __tls_size = __tls_end - __tls_base;
  __tls_align = MAX(ALIGNOF(.tdata), ALIGNOF(.tbss));
  __tbss_offset = __tbss_start - __tls_base;
  __arm32_tls_tcb_offset = MAX(8, __tls_align);
  __tdata_source = LOADADDR(.tdata);
  __INITIAL_SP = __StackTop;
  __STACK_LIMIT = __StackLimit;
}
